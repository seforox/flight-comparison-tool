# --- CONEXIÓN AL BACKEND ---
# Modo 1 (Ocultar Railway - Recomendado con acceso privado):
# El navegador llama a /api/proxy y Vercel reenvía a Railway usando API_INTERNAL_URL (solo servidor)
NEXT_PUBLIC_USE_API_PROXY="true"
API_INTERNAL_URL="https://tu-api.up.railway.app"

# Modo 2 (Directo desde el navegador, si NEXT_PUBLIC_USE_API_PROXY="false"):
# NEXT_PUBLIC_API_URL="https://tu-api.up.railway.app"

# --- PROTECCIÓN DE ACCESO PRIVADO (FLAGS ACTIVABLES/DESACTIVABLES) ---
# 1. Evitar indexación en Google/buscadores (robots.txt + X-Robots-Tag)
BLOCK_SEARCH_ENGINES="true"

# 2. Puerta privada por enlace mágico: https://tu-app.vercel.app/?key=TU_CLAVE_SECRETA
# Pon "true" para activar o "false" para abrir la web al público sin clave
PRIVATE_ACCESS_ENABLED="true"
SITE_ACCESS_KEY="genera-una-clave-secreta-para-tu-enlace"

# 3. Cabecera secreta hacia Railway (debe coincidir con API_GATEWAY_ENABLED y API_GATEWAY_SECRET en Railway)
API_GATEWAY_ENABLED="true"
API_GATEWAY_SECRET="genera-una-clave-larga-y-pon-la-misma-en-railway"
