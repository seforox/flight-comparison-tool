datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
  COMPLETED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  telegramChatId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  alerts         Alert[]
}

model Alert {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  originIata      String      // Ej: "MAD"
  destinationIata String      // Ej: "LON"
  departureDay    Int         // 1 = Lunes, ..., 7 = Domingo
  returnDay       Int         // 1 = Lunes, ..., 7 = Domingo
  adults          Int         @default(1) // Número de pasajeros
  directOnly      Boolean     @default(false) // true = Solo vuelos directos, false = Con escalas permitidas
  maxPriceEur     Decimal?    @db.Decimal(10, 2) // Presupuesto máximo opcional (null = sin límite de precio)
  startDate       DateTime    // Inicio del rango de monitorización
  endDate         DateTime    // Fin del rango de monitorización
  status          AlertStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  matches         Match[]
}

model Match {
  id            String   @id @default(uuid())
  alertId       String
  alert         Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  departureDate DateTime
  returnDate    DateTime
  foundPriceEur Decimal  @db.Decimal(10, 2)
  airlineCode   String?
  bookingUrl    String?
  notifiedAt    DateTime @default(now())
}

model Airport {
  iata       String   @id
  name       String
  city       String
  country    String
  popularity Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([city])
  @@index([country])
  @@index([popularity(sort: Desc)])
}
