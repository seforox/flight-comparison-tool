# Entorno y servidor
NODE_ENV=production
PORT=3001

# Dominios permitidos para CORS (separados por coma, sin barra final)
# En producción poner la URL de tu despliegue en Vercel
CORS_ORIGIN=https://tu-proyecto.vercel.app

# Base de datos PostgreSQL (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/flight_db?schema=public"

# Redis para BullMQ y blacklist de JWT (en Railway: ${{Redis.REDIS_URL}})
REDIS_URL="redis://localhost:6379"
# Alternativa si no usas REDIS_URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Seguridad JWT (en producción genera un secreto aleatorio de 64 chars)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-en-produccion"
JWT_EXPIRATION="7d"

# --- PROTECCIÓN DE ACCESO PRIVADO (FLAGS ACTIVABLES/DESACTIVABLES) ---
# Bloquear acceso directo a Railway: solo permite peticiones con la cabecera secreta desde Vercel (y GET /health)
# Pon "true" para activar o "false" para permitir acceso directo
API_GATEWAY_ENABLED="false"
API_GATEWAY_SECRET="genera-una-clave-larga-y-pon-la-misma-en-vercel"

# Control de registro de usuarios nuevos
# Pon "false" para cerrar nuevos registros por completo (ej. tras crear tu cuenta)
ALLOW_REGISTRATION="true"
# Lista blanca opcional de correos autorizados a registrarse (separados por coma; vacío = cualquiera)
ALLOWED_EMAILS=""

# Agente IA "Vera" (Google Gemini / Genkit)
USE_AGENT_MOCK="false"
GOOGLE_GENAI_API_KEY="tu-api-key-de-google-ai-studio"
GEMINI_MODEL="gemini-2.5-flash"

# Proveedor de vuelos (Ignav)
USE_IGNAV_MOCK="false"
IGNAV_API_KEY="tu-api-key-de-ignav"

# Notificaciones Telegram
TELEGRAM_BOT_TOKEN="tu-token-de-botfather"

# Frecuencia del Cron de revisión de alertas (cada 6 horas por defecto)
ALERT_CRON_SCHEDULE="0 */6 * * *"
